  },
  "engines": {
    "node": ">=16.17",
    "npm": ">=8"
  },
  "resolutions": {
    "@types/react": "^17.0.0",
    "@types/react-dom": "^17.0.0"
  },
  "dependencies": {
    "@electron/packager": "^20.0.1",
    "@playwright/test": "^1.59.1",
    "@sentry/cli": "^2.43.0",
    "@types/better-sqlite3": "^7.6.3",
    "@types/debug": "^4.1.2",
    "@types/event-kit": "^2.4.0",
    "@types/jasmine": "^1.3.1",
    "@types/lru-cache": "^5.1.0",
    "@types/moment-round": "^1.0.3",
    "@types/mousetrap": "^1.6.1",
    "@types/optimist": "^0.0.29",
    "@types/proxyquire": "^1.3.28",
    "@types/react": "^17.0.0",
    "@types/react-color": "^2.14.1",
    "@types/react-dom": "^17.0.0",
    "@types/react-test-renderer": "^17.0.0",
    "@types/react-transition-group": "4.4.12",
    "@types/reflux": "^6.4.2",
    "@types/rx-lite": "^4.0.6",
    "@types/slate": "^0.44.10",
    "@types/slate-base64-serializer": "^0.2.2",
    "@types/slate-html-serializer": "^0.6.3",
    "@types/slate-plain-serializer": "^0.6.1",
    "@types/slate-react": "^0.22.1",
    "@types/source-map-support": "^0.4.2",
    "@types/underscore": "^1.8.9",
    "@types/underscore.string": "^0.0.33",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "better-sqlite3": "^12.8.0",
    "chalk": "1.x.x",
    "devtron": "^1.4.0",
    "electron": "41.10.7",
    "electron-playwright-helpers": "^2.1.0",
    "electron-winstaller": "5.4.0",
    "eslint": "^8.0.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-import": "^2.29.0",
    "eslint-plugin-jsx-a11y": "^6.8.0",
    "eslint-plugin-prettier": "^5.0.0",
    "eslint-plugin-react": "^7.33.0",
    "fs-extra": "2.x.x",
    "fs-plus": "2.x.x",
    "glob": "7.x.x",
    "jasmine": "2.x.x",
    "license-extractor": "^1.0.4",
    "node-gyp": "^12.2.0",
    "prettier": "^3.0.0",
    "rimraf": "^2.6.1",
    "targz": "^1.0.1",
    "temp": "0.8.x",
    "typescript": "5.7.3",
    "underscore": "^1.13.1",
    "zod": "^4.4.3"
  },
  "scripts": {
    "postinstall": "node scripts/postinstall.js",
    "start": "electron ./app --enable-logging --dev",
    "lint": "eslint --fix -c .eslintrc \"app/src/**/*.{ts,tsx}\" \"app/internal_packages/**/*.{ts,tsx}\"",
    "lint:check": "eslint -c .eslintrc \"app/src/**/*.{ts,tsx}\" \"app/internal_packages/**/*.{ts,tsx}\"",
    "typecheck": "./node_modules/.bin/tsc -p app/tsconfig.json --noEmit",
    "test": "node scripts/test.js --test",
    "test:release": "node --test scripts/check-release-version.test.js scripts/prepare-windows-update-assets.test.js scripts/windows-installer-trust.test.js scripts/windows-menu-options.test.js scripts/windows-tray-assets.test.js",
    "test:update": "node --test scripts/nsis-update-engine.test.js scripts/prepare-windows-update-assets.test.js scripts/update-ui-policy.test.js",
    "test-window": "node scripts/test.js --test=window",
    "test:e2e": "npx playwright test --config playwright/playwright.config.ts",
    "artwork:windows-installer": "node app/build/generate-windows-installer-artwork.js",
    "artwork:windows-tray": "node app/build/generate-windows-tray-icons.js",
    "build:windows-installer": "node app/build/build-windows-installer.js",
    "signing:windows:internal:create": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/windows/New-KaiyueMailInternalCertificate.ps1",
    "signing:windows:internal:app": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/windows/Sign-KaiyueMailWindows.ps1 -Mode App",
    "signing:windows:internal:installer": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/windows/Sign-KaiyueMailWindows.ps1 -Mode Installer",
    "release:windows:internal": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/windows/Build-KaiyueMailInternalRelease.ps1",
    "release:windows-assets": "node scripts/prepare-windows-update-assets.js",
    "release:verify-windows-assets": "node scripts/verify-windows-update-assets.js --require-signature",
    "verify:windows-package": "node app/build/verify-windows-package.js",
    "verify:windows-runtime": "node app/build/verify-windows-runtime-dependencies.js",
    "release:check": "node scripts/check-release-version.js",
    "tsc-watch": "tsc -w -p ./app --noEmit",
    "build": "node app/build/build.js"
  },
  "overrides": {
    "tar": "7.5.21"
  }
}
